{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#172033"
        },
        {
          "slug": "canvas",
          "name": "Canvas",
          "color": "#f7f7f4"
        },
        {
          "slug": "brand",
          "name": "Brand",
          "color": "#2457d6"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#d9ff66"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#ffffff"
        }
      ]
    },
    "layout": {
      "contentSize": "48rem",
      "wideSize": "80rem"
    },
    "spacing": {
      "blockGap": true,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "20",
          "name": "Extra small",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "Small",
          "size": "0.75rem"
        },
        {
          "slug": "40",
          "name": "Regular",
          "size": "1rem"
        },
        {
          "slug": "50",
          "name": "Medium",
          "size": "1.5rem"
        },
        {
          "slug": "60",
          "name": "Large",
          "size": "2rem"
        },
        {
          "slug": "70",
          "name": "Extra large",
          "size": "3rem"
        },
        {
          "slug": "80",
          "name": "XX large",
          "size": "5rem"
        }
      ],
      "units": ["px", "rem", "%", "vw"]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "soft",
          "name": "Soft",
          "shadow": "0 1rem 3rem rgba(23, 32, 51, 0.16)"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Inter",
          "fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "serif",
          "name": "Astloch",
          "fontFamily": "\"Astloch\", system-ui"
        },
        {
          "slug": "basic",
          "name": "Basic",
          "fontFamily": "\"Basic\", sans-serif"
        },
        {
          "slug": "display",
          "name": "Jim Nightshade",
          "fontFamily": "\"Jim Nightshade\", cursive"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem"
        },
        {
          "slug": "medium",
          "name": "Body",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.25rem"
        },
        {
          "slug": "x-large",
          "name": "Heading 3",
          "size": "1.75rem"
        },
        {
          "slug": "xx-large",
          "name": "Heading 2",
          "size": "2.5rem"
        },
        {
          "slug": "display",
          "name": "Heading 1",
          "size": "4rem"
        }
      ]
    },
    "custom": {
      "radius": {
        "medium": "0.75rem",
        "large": "1.5rem"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--50)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.1"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--brand)"
        }
      }
    },
    "blocks": {
      "core/paragraph": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "lineHeight": "1.75"
        }
      },
      "core/button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var(--wp--preset--color--brand)",
          "text": "var(--wp--preset--color--white)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--30)",
            "right": "var(--wp--preset--spacing--50)",
            "bottom": "var(--wp--preset--spacing--30)",
            "left": "var(--wp--preset--spacing--50)"
          }
        },
        "typography": {
          "fontWeight": "700"
        }
      }
    }
  }
}
