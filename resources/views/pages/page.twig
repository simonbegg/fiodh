{% extends 'layouts/base.twig' %}

{% block content %}
    <article>
        <header class="bg-canvas px-6 py-16 text-ink">
            <div class="content-wrapper">
                <h1 class="font-bold text-4xl md:text-6xl tracking-tight">
                    {{ post.title|e }}
                </h1>
            </div>
        </header>

        <div class="is-layout-constrained">
            {{ post.content|raw }}
        </div>
    </article>
{% endblock %}
